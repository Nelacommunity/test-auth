# Tausi: must be reachable over https by Supabase (it downloads the JWKS), so use your deployment.
TAUSI_URL=https://auth.tausi.app
TAUSI_PUBLISHABLE_KEY=pk_replace_me
TAUSI_SECRET_KEY=sk_replace_me

# Supabase: Project Settings → API (the anon / publishable key, never the service_role key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
